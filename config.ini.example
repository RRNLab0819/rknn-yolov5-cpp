[camera]
count = 4

[cam0]
device = /dev/video0
label  = 前
width  = 1920
height = 1080

[cam1]
device = /dev/video1
label  = 后
width  = 1920
height = 1080

[cam2]
device = /dev/video2
label  = 左
width  = 1920
height = 1080

[cam3]
device = /dev/video3
label  = 右
width  = 1920
height = 1080

[model]
path        = model/yolov5.rknn
label_file  = model/coco_80_labels_list.txt
conf_thresh = 0.40
nms_thresh  = 0.45

[display]
fps_limit = 30

[watchdog]
infer_timeout_ms = 8000
cam_timeout_ms   = 5000

[log]
file = /var/log/rknn-avs.log
